/// A curated storefront image.
///
/// `startsAt`/`endsAt` are nullable rather than defaulted: a null bound means
/// "unbounded in that direction", so an evergreen banner is two nulls and a
/// scheduled one only carries the bound it needs. `isActive` is the kill
/// switch that does not require editing the window.
model Banner {
  id             String          @id @default(uuid())
  title          String
  imageUrl       String
  /// Narrower creative for small screens, served from the same B5 upload.
  mobileImageUrl String?
  linkType       BannerLinkType  @default(NONE)
  /// Product / category / vendor id, or an absolute URL when linkType is URL.
  /// Ignored when linkType is NONE.
  linkValue      String?
  placement      BannerPlacement
  sortOrder      Int             @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
  @@index([isActive, startsAt, endsAt])
  @@map("banners")
}

/// One ordered block on the storefront home page.
///
/// `config` stays a JSON blob because each `type` reads a different shape
/// (product ids, category ids, banner ids, flash-sale window) and normalising
/// them into columns would mean a wide sparse table plus a migration per new
/// block type. The shape is validated on write and documented on the type.
model HomeSection {
  id        String          @id @default(uuid())
  title     String
  type      HomeSectionType
  /// PRODUCT_LIST/FLASH_SALE: { productIds: string[] }
  /// CATEGORY_LIST: { categoryIds: string[] }
  /// BANNER: { bannerIds: string[] }
  /// FLASH_SALE also accepts { endsAt: ISO-8601 }
  config    Json
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([isActive, sortOrder])
  @@map("home_sections")
}

/// A time-boxed promotional window.
///
/// `startsAt`/`endsAt` are required rather than nullable: a flash sale with no
/// window is just a permanent discount, and making both bounds mandatory means
/// "live right now" is always a complete predicate. `isActive` is the kill
/// switch that does not require editing the window.
model FlashSale {
  id        String          @id @default(uuid())
  title     String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     FlashSaleItem[] @relation("FlashSaleToFlashSaleItem_1")

  @@index([isActive, startsAt, endsAt])
  @@map("flash_sales")
}

/// One discounted line inside a flash sale.
///
/// `stockLimit` is a cap on flash-sale units, deliberately separate from
/// `ProductVariant.stock`: the sale budget is a merchandising decision and must
/// not be consumable by ordinary checkout traffic. `soldCount` is the counter
/// checkout increments with a conditional update, so it is the authoritative
/// value — never computed as `stockLimit - something`.
///
/// The unique constraint is `[flashSaleId, productId, variantId]`, but note
/// PostgreSQL treats NULLs as distinct, so it does NOT cover rows with a NULL
/// `variantId`. Duplicates for product-level sales must be merged in the
/// service, exactly as `CartItem` does.
model FlashSaleItem {
  id           String              @id @default(uuid())
  flashSaleId  String
  flashSale    FlashSale           @relation("FlashSaleToFlashSaleItem_1", fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product             @relation("ProductToFlashSaleItem_1", fields: [productId], references: [id], onDelete: Cascade)
  /// Null means the discount applies to the product as a whole rather than one
  /// variant. Checkout still requires a specific variant; the sale price is
  /// simply shared across them.
  variantId    String?
  variant      ProductVariant?     @relation("ProductVariantToFlashSaleItem_1", fields: [variantId], references: [id], onDelete: Cascade)
  salePrice    Decimal             @db.Decimal(12, 2)
  /// Flash-sale unit budget. Enforced by the conditional increment at checkout.
  stockLimit   Int
  /// Units committed by non-cancelled orders. Incremented and decremented
  /// transactionally; never derived.
  soldCount    Int                 @default(0)
  perUserLimit Int                 @default(1)
  status       FlashSaleItemStatus @default(NOMINATED)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  orderItems OrderItem[] @relation("OrderItemToFlashSaleItem_1")

  @@unique([flashSaleId, productId, variantId])
  @@index([flashSaleId, status])
  @@index([productId])
  @@map("flash_sale_items")
}

/// A product name and description in one language.
///
/// The base `Product.name`/`description` are the English (or "default") values
/// and are never replaced. A translation is an override layered on top, so
/// dropping one row reverts that field to English rather than deleting it.
/// This is why the base column is not itself a `Locale` row.
model ProductTranslation {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation("ProductToProductTranslation_1", fields: [productId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

/// Category name in one language. Categories have no description to translate.
model CategoryTranslation {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation("CategoryToCategoryTranslation_1", fields: [categoryId], references: [id], onDelete: Cascade)
  locale     Locale
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

/// Brand name in one language.
model BrandTranslation {
  id        String   @id @default(uuid())
  brandId   String
  brand     Brand    @relation("BrandToBrandTranslation_1", fields: [brandId], references: [id], onDelete: Cascade)
  locale    Locale
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, locale])
  @@index([locale])
  @@map("brand_translations")
}
