// Stage 9: Infra (WebhookEvent, QueueEvent, Session)
// Models: WebhookEvent, QueueEvent, Session

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS (from stages 1-9 - all enums)
// ---------------------------------------------------------------------------

// --- ENUMS ---

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VENDOR
  VENDOR_STAFF
  CUSTOMER
}

/// An external identity provider this store accepts sign-in from.
///
/// The provider is part of the composite unique key rather than a free string,
/// so the same subject id at Google and at Facebook stay two distinct
/// accounts and one provider's user id can never be replayed against another.
enum SocialProvider {
  GOOGLE
  FACEBOOK
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum SaleType {
  RETAIL
  WHOLESALE
  BOTH
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum SaleChannel {
  RETAIL
  WHOLESALE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentGateway {
  STRIPE
  BKASH
  NAGAD
  SSLCOMMERZ
  COD
}

// Lifecycle of the money owed on an order, independent of the gateway.
// UNPAID            no payment method chosen yet
// PENDING_COD       buyer chose cash on delivery; money not yet collected
// PAID              settled in full
// PARTIALLY_REFUNDED settled then partly returned to the buyer
// REFUNDED          settled then fully returned to the buyer
enum PaymentStatus {
  UNPAID
  PENDING_COD
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum TransactionType {
  PAYMENT
  PAYOUT
  REFUND
  ADJUSTMENT
  /// Platform commission withheld from a vendor at delivery. Money moving from
  /// VENDOR to PLATFORM, so the platform books a CREDIT.
  COMMISSION
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum PartyType {
  CUSTOMER
  VENDOR
  PLATFORM
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENT
  FIXED
}

/// Where a banner is rendered. `POPUP` is shown at most once per browsing
/// session; the other placements are slot-based and ordered by `sortOrder`.
enum BannerPlacement {
  HOME_HERO
  HOME_MID
  CATEGORY_TOP
  POPUP
}

/// What a banner click navigates to. `NONE` makes the banner non-clickable,
/// which is why it is a first-class value rather than an empty link.
enum BannerLinkType {
  PRODUCT
  CATEGORY
  VENDOR
  URL
  NONE
}

enum HomeSectionType {
  PRODUCT_LIST
  CATEGORY_LIST
  BANNER
  FLASH_SALE
}

/// The languages a translation row may be written in.
///
/// An enum rather than a free string so a typo like "bengali" cannot create a
/// fourth locale that no fallback chain ever consults. `DEFAULT_LOCALE` is "en"
/// and must always exist as a value: it is the base language, and every
/// translation is an override of it rather than a replacement.
enum Locale {
  en
  bn
}

/// Lifecycle of a vendor's nomination for a flash sale. A nomination is inert
/// until an admin approves it, so a vendor cannot grant themselves a discount.
enum FlashSaleItemStatus {
  NOMINATED
  APPROVED
  REJECTED
}

enum ChatThreadType {
  BUYER_VENDOR
  BUYER_SUPPORT
}

enum ChatThreadStatus {
  OPEN
  CLOSED
}

enum StorageDriver {
  LOCAL
  S3
  GCS
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum MailDriver {
  SMTP
  TWILIO
}

enum CourierProvider {
  PATHAO
  STEADFAST
  MANUAL
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

/// What a one-time code is being used for. Codes are never interchangeable
/// across purposes, so a LOGIN code cannot be spent on a password reset.
enum OtpPurpose {
  LOGIN
  REGISTER
  RESET_PASSWORD
  VERIFY_PHONE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  REFUNDED
  CLOSED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  COMPLETED
  FAILED
}

enum CampaignAudience {
  ALL_CUSTOMERS
  ALL_VENDORS
  CUSTOM_SEGMENT
}

// --- MODELS ---

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation("AddressToUser_1", fields: [userId], references: [id], onDelete: Cascade)
  label         String?
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  district      String?
  postalCode    String?
  country       String   @default("BD")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  description     String?
  rolePermissions RolePermission[] @relation("PermissionToRolePermission_1")

  @@map("permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation("RefreshTokenToUser_1", fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// A hashed one-time passcode sent over SMS.
///
/// The plaintext code is never stored: only an Argon2id hash, which is why
/// verification has to re-hash and compare rather than look the code up. `target`
/// is a normalised E.164 phone number, so a code issued to `01…` is found when
/// the same person later types `+8801…`.
model OtpCode {
  id         String     @id @default(uuid())
  target     String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([target, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

/// A buyer's request to return part or all of a delivered order.
///
/// The window is measured from the DELIVERED status-history row rather than from
/// `updatedAt`, which changes on every later write and would silently extend or
/// revoke a customer's window.
model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String
  order        Order        @relation("ReturnRequestToOrder_1", fields: [orderId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User         @relation("ReturnRequestToBuyer_1", fields: [buyerId], references: [id], onDelete: Restrict)
  vendorId     String
  vendor       Vendor       @relation("ReturnRequestToVendor_1", fields: [vendorId], references: [id], onDelete: Restrict)
  status       ReturnStatus @default(REQUESTED)
  reason       ReturnReason
  comment      String?
  /// Object keys or URLs for photos the buyer attached. Non-relational on
  /// purpose: evidence is immutable once filed and has no lifecycle of its own.
  evidenceUrls String[]     @default([])
  /// Set when the refund is issued; null while the return is still in flight.
  refundAmount Decimal?     @db.Decimal(12, 2)
  decidedById  String?
  decidedBy    User?        @relation("ReturnDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionNote String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        ReturnItem[] @relation("ReturnRequestToReturnItem_1")

  @@index([orderId])
  @@index([buyerId])
  @@index([vendorId])
  @@index([status])
  @@map("return_requests")
}

/// One line of a return, referencing the original order line.
model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation("ReturnRequestToReturnItem_1", fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation("OrderItemToReturnItem_1", fields: [orderItemId], references: [id], onDelete: Restrict)
  qty             Int

  @@index([returnRequestId])
  @@index([orderItemId])
  @@map("return_items")
}

/// A product a buyer has saved for later.
///
/// One row per (user, product) with a unique constraint behind it, so the
/// "add to wishlist" button is naturally idempotent rather than something the
/// service has to check first.
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("WishlistItemToUser_1", fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation("WishlistItemToProduct_1", fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

/// A buyer's question about a product, and the vendor's or platform's answer.
///
/// Modelled on Review: both are user-generated text that needs moderation
/// before it is public, so they share the `ReviewStatus` lifecycle rather than
/// inventing a second one.
model ProductQuestion {
  id            String          @id @default(uuid())
  productId     String
  product       Product         @relation("ProductToProductQuestion_1", fields: [productId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation("ProductQuestionToUser_1", fields: [userId], references: [id], onDelete: Cascade)
  question      String
  status        ReviewStatus    @default(PENDING)
  /// Why a moderator rejected it. Kept so the decision is auditable and the
  /// asker can be told why, rather than the question simply vanishing.
  note          String?
  moderatedById String?
  moderatedBy   User?           @relation("ProductQuestionModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  /// Set once a vendor or admin has replied, so the asker can be notified and
  /// the listing can show "answered" without a join.
  answeredAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  answers       ProductAnswer[] @relation("ProductQuestionToProductAnswer_1")

  @@index([productId, status])
  @@index([userId])
  @@map("product_questions")
}

model ProductAnswer {
  id           String          @id @default(uuid())
  questionId   String
  question     ProductQuestion @relation("ProductQuestionToProductAnswer_1", fields: [questionId], references: [id], onDelete: Cascade)
  answeredById String
  answeredBy   User            @relation("ProductAnswerToUser_1", fields: [answeredById], references: [id], onDelete: Cascade)
  /// Whether the reply came from the vendor who sells the product. An admin
  /// reply is support, not the seller's own voice, and the UI says so.
  isVendor     Boolean         @default(false)
  answer       String
  createdAt    DateTime        @default(now())

  @@index([questionId])
  @@map("product_answers")
}

/// Records that a PAYOUT has netted off one negative ADJUSTMENT.
///
/// A refund issued after the vendor was already paid leaves the platform owing
/// them money, booked as an ADJUSTMENT. The next payout subtracts it — this row
/// is how that subtraction is remembered, so the same debt is never deducted
/// twice. `amount` is denormalised from the adjustment so the settled total is a
/// single aggregate, with no join back into `transactions`.
///
/// A model rather than a column on `Transaction` on purpose: `Transaction`
/// arrives in an earlier stage, and a field on it would have to be created
/// there, far from the return flow that gives it meaning.
model PayoutAdjustment {
  id           String      @id @default(uuid())
  payoutId     String
  payout       Transaction @relation("PayoutToPayoutAdjustment_1", fields: [payoutId], references: [id], onDelete: Cascade)
  adjustmentId String      @unique
  adjustment   Transaction @relation("AdjustmentToPayoutAdjustment_1", fields: [adjustmentId], references: [id], onDelete: Cascade)
  amount       Decimal     @db.Decimal(12, 2)
  createdAt    DateTime    @default(now())

  @@index([payoutId])
  @@map("payout_adjustments")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[] @relation("RoleToRolePermission_1")
  users       User[]           @relation("RoleToUser_1")
  auditLogs   RoleAuditLog[]   @relation("RoleToRoleAuditLog_1")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model RoleAuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation("RoleAuditLogToUser_1", fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  targetRoleId String
  diff         String?
  createdAt    DateTime @default(now())
  targetRole   Role     @relation("RoleToRoleAuditLog_1", fields: [targetRoleId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([targetRoleId])
  @@map("role_audit_logs")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation("RoleToRolePermission_1", fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation("PermissionToRolePermission_1", fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                 String               @id @default(uuid())
  email              String?              @unique
  phone              String?              @unique
  password           String
  name               String
  role               UserRole             @default(CUSTOMER)
  roleId             String?
  rbacRole           Role?                @relation("RoleToUser_1", fields: [roleId], references: [id])
  avatarUrl          String?
  /// The language this user's notifications are written in.
  ///
  /// Stored rather than derived from a request header, because a notification
  /// is delivered out of band: by the time the order-confirmation email is
  /// rendered there is no request whose `Accept-Language` could be consulted.
  /// Defaults to the same base language the product catalogue falls back to.
  preferredLocale    Locale               @default(en)
  isVerified         Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  refreshTokens      RefreshToken[]       @relation("RefreshTokenToUser_1")
  auditLogs          RoleAuditLog[]       @relation("RoleAuditLogToUser_1")
  vendor             Vendor?              @relation("UserVendor")
  addresses          Address[]            @relation("AddressToUser_1")
  cart               Cart?                @relation("CartToUser_1")
  ordersAsBuyer      Order[]              @relation("OrderBuyer")
  orderStatusChanges OrderStatusHistory[] @relation("StatusChangedBy")
  reviews            Review[]             @relation("ReviewToUser_1")
  chatMessagesSent   ChatMessage[]        @relation("MessageSender")
  chatThreadsAsBuyer ChatThread[]         @relation("ThreadBuyer")
  chatThreadsAsAdmin ChatThread[]         @relation("ThreadAdmin")
  reviewsModerated   Review[]             @relation("ReviewModerator")
  storageFiles       StorageFile[]        @relation("FileOwnerUser")
  deviceTokens       DeviceToken[]        @relation("DeviceTokenToUser_1")
  notificationLogs   NotificationLog[]    @relation("NotificationLogToUser_1")
  returnRequests     ReturnRequest[]      @relation("ReturnRequestToBuyer_1")
  wishlistItems      WishlistItem[]       @relation("WishlistItemToUser_1")
  productQuestions   ProductQuestion[]    @relation("ProductQuestionToUser_1")
  questionsModerated ProductQuestion[]    @relation("ProductQuestionModerator")
  productAnswers     ProductAnswer[]      @relation("ProductAnswerToUser_1")
  returnDecisions    ReturnRequest[]      @relation("ReturnDecidedBy")
  socialAccounts     SocialAccount[]      @relation("SocialAccountToUser_1")

  @@index([role])
  @@map("users")
}

/// A verified identity at an external provider, linked to a local user.
///
/// `providerUserId` is the provider's own stable subject id, never the email:
/// emails get reassigned and recycled at both providers, so keying on one would
/// let a later holder of a recycled address inherit the previous account.
model SocialAccount {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation("SocialAccountToUser_1", fields: [userId], references: [id], onDelete: Cascade)
  provider       SocialProvider
  providerUserId String
  /// The address the provider reported at link time, recorded for display and
  /// support. It is never the key: a user may change it at the provider, and a
  /// stale copy here must not decide who a returning visitor is.
  email          String?
  createdAt      DateTime       @default(now())

  /// One provider identity maps to at most one local account. This is the
  /// constraint that makes a replayed token resolve to the same user instead of
  /// minting a second account.
  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

model Vendor {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation("UserVendor", fields: [userId], references: [id], onDelete: Cascade)
  businessName      String
  slug              String          @unique
  logoUrl           String?
  bannerUrl         String?
  description       String?
  kycStatus         KycStatus       @default(PENDING)
  status            VendorStatus    @default(PENDING)
  commissionRate    Decimal         @default(10.0) @db.Decimal(5, 2)
  payoutMethod      String?
  payoutAccountInfo Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  kycDocuments      StorageFile[]   @relation("VendorKycDocs")
  products          Product[]       @relation("ProductToVendor_1")
  orders            Order[]         @relation("OrderVendor")
  returnRequests    ReturnRequest[] @relation("ReturnRequestToVendor_1")
  transactions      Transaction[]   @relation("TransactionToVendor_1")
  coupons           Coupon[]        @relation("CouponToVendor_1")
  chatThreads       ChatThread[]    @relation("ThreadVendor")

  @@index([status])
  @@index([kycStatus])
  @@map("vendors")
}

model Category {
  id           String                @id @default(uuid())
  name         String
  slug         String                @unique
  imageUrl     String?
  sortOrder    Int                   @default(0)
  isActive     Boolean               @default(true)
  parentId     String?
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryTree")
  products     Product[]             @relation("CategoryToProduct_1")
  translations CategoryTranslation[] @relation("CategoryToCategoryTranslation_1")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([parentId])
  @@map("categories")
}

/// A manufacturer label, independent of the vendor who happens to sell the
/// product. Optional on a product: plenty of goods have no brand, and forcing
/// one would mean inventing data.
model Brand {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  logoUrl      String?
  isActive     Boolean            @default(true)
  products     Product[]          @relation("ProductToBrand_1")
  translations BrandTranslation[] @relation("BrandToBrandTranslation_1")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([isActive])
  @@map("brands")
}

model Product {
  id              String               @id @default(uuid())
  brandId         String?
  brand           Brand?               @relation("ProductToBrand_1", fields: [brandId], references: [id], onDelete: SetNull)
  vendorId        String
  vendor          Vendor               @relation("ProductToVendor_1", fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category             @relation("CategoryToProduct_1", fields: [categoryId], references: [id], onDelete: Restrict)
  name            String
  slug            String               @unique
  description     String?
  saleType        SaleType             @default(RETAIL)
  status          ProductStatus        @default(DRAFT)
  price           Decimal              @db.Decimal(12, 2)
  minOrderQty     Int?
  weightGrams     Int                  @default(500)
  countryOfOrigin String?
  /// Denormalised review aggregate, recomputed whenever a review is approved
  /// or rejected. Kept on the product so search can sort and filter by rating
  /// without a join, and so the listing endpoint stays a single query.
  ratingAvg       Decimal              @default(0) @db.Decimal(3, 2)
  ratingCount     Int                  @default(0)
  /// Units actually delivered, accumulated when an order reaches DELIVERED.
  /// Drives the "popular" sort. Not decremented on return: the units were
  /// genuinely sold, and a return does not un-sell them.
  soldCount       Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  variants        ProductVariant[]     @relation("ProductToProductVariant_1")
  priceTiers      ProductPriceTier[]   @relation("ProductToProductPriceTier_1")
  images          ProductImage[]       @relation("ProductToProductImage_1")
  reviews         Review[]             @relation("ProductToReview_1")
  cartItems       CartItem[]           @relation("CartItemToProduct_1")
  wishlistItems   WishlistItem[]       @relation("WishlistItemToProduct_1")
  questions       ProductQuestion[]    @relation("ProductToProductQuestion_1")
  flashSaleItems  FlashSaleItem[]      @relation("ProductToFlashSaleItem_1")
  translations    ProductTranslation[] @relation("ProductToProductTranslation_1")

  @@index([vendorId, status])
  @@index([categoryId])
  @@index([brandId])
  @@index([saleType])
  @@index([soldCount])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation("ProductToProductImage_1", fields: [productId], references: [id], onDelete: Cascade)
  /// The 1200px ("large") WebP variant.
  url       String
  /// 200px WebP variant. Null on rows created before the image pipeline.
  thumbUrl  String?
  /// 600px WebP variant. Null on rows created before the image pipeline.
  mediumUrl String?
  /// Intrinsic dimensions of the source image, so the client can reserve layout
  /// space and avoid a reflow while the bytes load.
  width     Int?
  height    Int?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, isPrimary])
  @@map("product_images")
}

model ProductPriceTier {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation("ProductToProductPriceTier_1", fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int
  maxQty    Int?
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([productId, minQty])
  @@map("product_price_tiers")
}

model ProductVariant {
  id                 String          @id @default(uuid())
  productId          String
  product            Product         @relation("ProductToProductVariant_1", fields: [productId], references: [id], onDelete: Cascade)
  sku                String          @unique
  attributes         Json
  stock              Int             @default(0)
  priceOverride      Decimal?        @db.Decimal(12, 2)
  lowStockAlertAt    Int             @default(5)
  /// Set the first time the vendor is warned about low stock for this variant.
  /// Reset to null once stock recovers above the alert level, so the next
  /// dip warns again. A date rather than a boolean because the warning is
  /// useful to audit.
  lowStockNotifiedAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  cartItems          CartItem[]      @relation("CartItemToProductVariant_1")
  orderItems         OrderItem[]     @relation("OrderItemToProductVariant_1")
  flashSaleItems     FlashSaleItem[] @relation("ProductVariantToFlashSaleItem_1")

  @@index([productId])
  @@map("product_variants")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation("CartToUser_1", fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[] @relation("CartToCartItem_1")
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  @@map("carts")
}

model CartItem {
  id               String          @id @default(uuid())
  cartId           String
  cart             Cart            @relation("CartToCartItem_1", fields: [cartId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation("CartItemToProduct_1", fields: [productId], references: [id], onDelete: Cascade)
  productVariantId String?
  productVariant   ProductVariant? @relation("CartItemToProductVariant_1", fields: [productVariantId], references: [id], onDelete: SetNull)
  qty              Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([cartId, productId, productVariantId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                String               @id @default(uuid())
  orderGroupId      String
  orderNumber       String               @unique
  buyerId           String
  buyer             User                 @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  vendorId          String
  vendor            Vendor               @relation("OrderVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  saleChannel       SaleChannel
  status            OrderStatus          @default(PENDING)
  subtotal          Decimal              @db.Decimal(12, 2)
  discountTotal     Decimal              @default(0) @db.Decimal(12, 2)
  shippingFee       Decimal              @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal              @db.Decimal(12, 2)
  /// Commission snapshot, written once when the order reaches DELIVERED.
  /// Null until then. These are deliberately denormalised: the rate a vendor is
  /// charged must not move when the platform later edits commissionRate, and a
  /// payout must reproduce the figures from the moment of delivery.
  commissionRate    Decimal?             @db.Decimal(5, 2)
  commissionAmount  Decimal?             @db.Decimal(12, 2)
  vendorEarning     Decimal?             @db.Decimal(12, 2)
  couponId          String?
  coupon            Coupon?              @relation("CouponToOrder_1", fields: [couponId], references: [id], onDelete: SetNull)
  paymentMethod     PaymentGateway?
  paymentStatus     PaymentStatus        @default(UNPAID)
  shippingAddress   Json
  /// Checkout deadline for online payment. Set to now + ORDER_PAYMENT_TTL_MINUTES
  /// at checkout, cleared to null once COD is selected, and indexed so the expiry
  /// sweep can find due orders without scanning the whole table.
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  items             OrderItem[]          @relation("OrderToOrderItem_1")
  statusHistory     OrderStatusHistory[] @relation("OrderToOrderStatusHistory_1")
  transactions      Transaction[]        @relation("OrderToTransaction_1")
  transactionOrders TransactionOrder[]   @relation("OrderToTransactionOrder_1")
  shipments         Shipment[]           @relation("OrderToShipment_1")
  returnRequests    ReturnRequest[]      @relation("ReturnRequestToOrder_1")

  @@index([orderGroupId])
  @@index([buyerId, status])
  @@index([vendorId, status])
  @@index([status, paymentStatus, expiresAt])
  @@map("orders")
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  order            Order          @relation("OrderToOrderItem_1", fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation("OrderItemToProductVariant_1", fields: [productVariantId], references: [id], onDelete: Restrict)
  productNameSnap  String
  qty              Int
  unitPrice        Decimal        @db.Decimal(12, 2)
  lineTotal        Decimal        @db.Decimal(12, 2)
  /// The flash sale this line was bought under, if any.
  ///
  /// This is what makes the sale budget releasable: on cancellation the service
  /// decrements `FlashSaleItem.soldCount` by this line's qty. Without the
  /// reference, a cancelled order's units would stay consumed in the sale
  /// counter forever, shrinking the budget permanently. Null for ordinary
  /// orders.
  flashSaleItemId  String?
  flashSaleItem    FlashSaleItem? @relation("OrderItemToFlashSaleItem_1", fields: [flashSaleItemId], references: [id], onDelete: SetNull)
  returnItems      ReturnItem[]   @relation("OrderItemToReturnItem_1")

  @@index([orderId])
  @@index([productVariantId])
  /// The cancellation sweep walks "every order item bought on sale" by sale id.
  @@index([flashSaleItemId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation("OrderToOrderStatusHistory_1", fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  changedBy   User?        @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model Transaction {
  id                 String               @id @default(uuid())
  type               TransactionType
  direction          TransactionDirection
  status             TransactionStatus    @default(PENDING)
  amount             Decimal              @db.Decimal(12, 2)
  currency           String               @default("BDT")
  fromType           PartyType
  fromId             String?
  toType             PartyType
  toId               String?
  gateway            PaymentGateway?
  externalRef        String?              @unique
  rawResponse        Json?
  payoutMethod       String?
  vendorId           String?
  vendor             Vendor?              @relation("TransactionToVendor_1", fields: [vendorId], references: [id], onDelete: SetNull)
  orderId            String?
  order              Order?               @relation("OrderToTransaction_1", fields: [orderId], references: [id], onDelete: SetNull)
  note               String?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  settledOrders      TransactionOrder[]   @relation("TransactionToTransactionOrder_1")
  settledAdjustments PayoutAdjustment[]   @relation("PayoutToPayoutAdjustment_1")
  offsetByPayout     PayoutAdjustment?    @relation("AdjustmentToPayoutAdjustment_1")

  @@index([type, status])
  @@index([orderId])
  @@index([vendorId, type, status])
  @@index([fromType, fromId])
  @@index([toType, toId])
  @@map("transactions")
}

model TransactionOrder {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation("TransactionToTransactionOrder_1", fields: [transactionId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order       @relation("OrderToTransactionOrder_1", fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([transactionId, orderId])
  @@index([orderId])
  @@map("transaction_orders")
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  vendorId      String?
  vendor        Vendor?      @relation("CouponToVendor_1", fields: [vendorId], references: [id], onDelete: Cascade)
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  minOrderValue Decimal?     @db.Decimal(12, 2)
  usageLimit    Int?
  usedCount     Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  orders        Order[]      @relation("CouponToOrder_1")

  @@index([vendorId])
  @@index([isActive, expiresAt])
  @@map("coupons")
}

model Review {
  id                 String       @id @default(uuid())
  productId          String
  product            Product      @relation("ProductToReview_1", fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation("ReviewToUser_1", fields: [userId], references: [id], onDelete: Cascade)
  rating             Int
  comment            String?
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(PENDING)
  moderatedById      String?
  moderatedBy        User?        @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}

model ChatMessage {
  id            String     @id @default(uuid())
  threadId      String
  thread        ChatThread @relation("ChatMessageToChatThread_1", fields: [threadId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User       @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content       String?
  attachmentUrl String?
  readAt        DateTime?
  createdAt     DateTime   @default(now())
  deletedAt     DateTime?

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

model ChatParticipantState {
  id                String     @id @default(uuid())
  threadId          String
  thread            ChatThread @relation("ChatParticipantStateToChatThread_1", fields: [threadId], references: [id], onDelete: Cascade)
  userId            String
  unreadCount       Int        @default(0)
  lastReadMessageId String?
  isMuted           Boolean    @default(false)
  updatedAt         DateTime   @updatedAt

  @@unique([threadId, userId])
  @@map("chat_participant_states")
}

model ChatThread {
  id                String                 @id @default(uuid())
  buyerId           String
  buyer             User                   @relation("ThreadBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  vendorId          String?
  vendor            Vendor?                @relation("ThreadVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  adminId           String?
  admin             User?                  @relation("ThreadAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  type              ChatThreadType
  status            ChatThreadStatus       @default(OPEN)
  lastMessageAt     DateTime?
  createdAt         DateTime               @default(now())
  messages          ChatMessage[]          @relation("ChatMessageToChatThread_1")
