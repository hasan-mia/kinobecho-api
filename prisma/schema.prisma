}

model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  provider    String
  type        String
  payload     Json
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([provider, type])
  @@map("webhook_events")
