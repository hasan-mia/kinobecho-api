# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kinobecho?schema=public
DATABASE_PROVIDER=postgresql

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Social sign-in (Google / Facebook).
# Leave GOOGLE_CLIENT_IDS empty to disable Google sign-in: the endpoint then
# returns 503 "not configured" rather than accepting an unverified token.
# Accepts a comma-separated list so web, iOS and Android client ids can coexist.
GOOGLE_CLIENT_IDS=
# Required for Facebook sign-in; the access token is validated against this app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Local payments gateways (Bangladesh)
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_WEBHOOK_SECRET=your-bkash-webhook-secret

NAGAD_MERCHANT_ID=your-nagad-merchant-id
NAGAD_API_KEY=your-nagad-api-key
NAGAD_API_SECRET=your-nagad-api-secret
NAGAD_WEBHOOK_SECRET=your-nagad-webhook-secret

SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_API_KEY=your-sslcommerz-api-key
SSLCOMMERZ_API_SECRET=your-sslcommerz-api-secret
SSLCOMMERZ_SANDBOX=true

# Storage (local | s3 | gcs)
STORAGE_DRIVER=local
LOCAL_UPLOAD_PATH=uploads
LOCAL_ASSET_URL=/uploads

# AWS S3 (when STORAGE_DRIVER=s3)
AWS_S3_BUCKET=your-s3-bucket
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_FORCE_PATH_STYLE=false

# Google Cloud Storage (when STORAGE_DRIVER=gcs)
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET=your-gcp-bucket
GCP_CREDENTIALS_BASE64=base64-encoded-service-account-json

# Mail (smtp | twilio)
MAIL_DRIVER=smtp
MAIL_FROM=no-reply@kinobecho.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Firebase Cloud Messaging (push)
FCM_SERVICE_ACCOUNT_
FCM_PROJECT_ID=roshoon-app

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=900000
THROTTLE_AUTH_LIMIT=5

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Cash on delivery
COD_ENABLED=true
COD_MAX_AMOUNT=20000

# Minutes an unpaid online order stays payable before auto-cancellation (COD exempt)
ORDER_PAYMENT_TTL_MINUTES=30

# --- SMS / OTP ---
# Outbound SMS driver: 'http' (local Bangladeshi gateway) or 'twilio'.
SMS_DRIVER=http
# Twilio (only used when SMS_DRIVER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Local gateway (only used when SMS_DRIVER=http)
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
SMS_HTTP_SENDER_ID=
# Request template. Placeholders: {to} {text} {api_key} {sender_id}
SMS_HTTP_TEMPLATE={"to":"{to}","message":"{text}","sender_id":"{sender_id}","apikey":"{api_key}"}
# One-time passcode policy
# Days after delivery during which a buyer may file a return.
RETURN_WINDOW_DAYS=7

# Product search. Set SEARCH_ENABLED=false to stay on the Postgres fallback.
SEARCH_ENABLED=true
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=kinobecho_master_key
MEILI_INDEX=products

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=3
OTP_REQUEST_WINDOW_SECONDS=600

# --- Images / CDN ---
# When set, all public URLs are built as CDN_BASE_URL + key.
CDN_BASE_URL=
# Upload guards and WebP encoding
IMAGE_MAX_BYTES=5242880
IMAGE_MAX_DIMENSION=6000
IMAGE_WEBP_QUALITY=80



# Shipping / couriers
SHIPPING_DEFAULT_ZONE_NAME=DEFAULT
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_TOKEN=
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_WEBHOOK_SECRET=
PATHAO_WEBHOOK_INTEGRATION_SECRET=
